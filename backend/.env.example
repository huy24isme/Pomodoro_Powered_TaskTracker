# Server Configuration
NODE_ENV=development
PORT=5000

# Client URLs (comma-separated for multiple origins)
CLIENT_URLS=http://localhost:3000

# MongoDB Configuration
# For Docker: use 'pomodoro-mongodb' as host | For local: use 'localhost'
MONGO_URI=mongodb://admin:password@pomodoro-mongodb:27017/pomodoro-tracker?authSource=admin
MONGO_USERNAME=admin
MONGO_PASSWORD=password
MONGO_DATABASE=pomodoro-tracker
MONGO_PORT=27017

# Redis Configuration
# For Docker: use 'pomodoro-redis' as host | For local: use 'localhost'
REDIS_HOST=pomodoro-redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
